PORT=4000
NODE_ENV=development
# Oracle (SQL*Plus): sqlplus system/admin@//localhost:1521/XEPDB1
ORACLE_CONNECT=localhost/XEPDB1
# Least-privilege app user created by db/oracle_schema.sql — NEVER put system here
DB_USER=mentor_app
DB_PASSWORD=CHANGEME_match_db_user_password
# min 32 chars; server refuses to boot in production with a weak secret
JWT_SECRET=CHANGEME_min_32_chars_use_openssl_rand_hex_32
JWT_EXPIRES=12h
CORS_ORIGIN=http://localhost:5173
